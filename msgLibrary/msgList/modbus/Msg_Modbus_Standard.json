      ],
      "rx": [
        {"name": "bytes", "label": "Nombre d'octets", "label_en": "Byte count", "type": "uint16"},
        {"name": "count", "label": "Nombre de registres", "label_en": "FIFO count", "type": "uint16", "max": 31},
        {"name": "registers", "label": "Registres", "label_en": "Registers", "type": "raw"}
      ]
    },

    // --- 2B / MEI 0E : identification de l'appareil / read device identification -----------
    {
      "name": "2B Lire identification",
      "name_en": "2B Read device identification",
      "id": "0x2B",
      "group": "DIAG",
      "description": "MEI 0x0E. Code 1 = identification de base (fabricant, produit, version), 2 = standard, 3 = étendue, 4 = un objet précis.",
      "description_en": "MEI 0x0E. Code 1 = basic identification (vendor, product, version), 2 = regular, 3 = extended, 4 = one specific object.",
