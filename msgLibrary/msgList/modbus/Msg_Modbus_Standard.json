      ],
      "rx": [
        {"name": "bytes", "label": "Nombre d'octets", "label_en": "Byte count", "type": "uint8"},
        {"name": "requests", "label": "Sous-requêtes", "label_en": "Sub-requests", "type": "raw"}
      ]
    },

    // --- 16 : écriture masquée d'un registre / mask write register -------------------------
    {
      "name": "16 Écrire registre avec masque",
      "name_en": "16 Mask write register",
      "id": "0x16",
      "group": "WRITE",
      "description": "Résultat = (valeur actuelle AND masque ET) OR (masque OU AND NOT masque ET). Permet de changer quelques bits d'un registre. Réponse : écho de la requête.",
      "description_en": "Result = (current value AND and-mask) OR (or-mask AND NOT and-mask). Changes some bits of a register. Response: echo of the request.",
      "attributes": {"access": "W"},
      "tx": [
        {"name": "address", "label": "Adresse", "label_en": "Address", "type": "uint16", "default": "0x0000"},
        {"name": "and_mask", "label": "Masque ET", "label_en": "And mask", "type": "uint16", "default": "0xFFFF"},
        {"name": "or_mask", "label": "Masque OU", "label_en": "Or mask", "type": "uint16", "default": "0x0000"}
      ],
      "rx": [
        {"name": "address", "label": "Adresse", "label_en": "Address", "type": "uint16"},
        {"name": "and_mask", "label": "Masque ET", "label_en": "And mask", "type": "uint16"},
        {"name": "or_mask", "label": "Masque OU", "label_en": "Or mask", "type": "uint16"}
      ]
    },

    // --- 17 : lecture / écriture de registres / read-write multiple registers --------------
    {
      "name": "17 Lire et écrire des registres",
      "name_en": "17 Read/write multiple registers",
      "id": "0x17",
      "group": "WRITE",
      "description": "Écrit 1 à 121 registres puis lit 1 à 125 registres, en une trame (l'écriture se fait avant la lecture).",
      "description_en": "Writes 1 to 121 registers then reads 1 to 125 registers, in one frame (the write is done before the read).",
      "attributes": {"access": "RW"},
      "tx": [
        {"name": "read_address", "label": "Adresse de lecture", "label_en": "Read start address", "type": "uint16", "default": "0x0000"},
        {"name": "read_quantity", "label": "Nombre à lire", "label_en": "Quantity to read", "type": "uint16", "default": 1, "min": 1, "max": 125},
        {"name": "write_address", "label": "Adresse d'écriture", "label_en": "Write start address", "type": "uint16", "default": "0x0000"},
        {"name": "write_quantity", "label": "Nombre à écrire", "label_en": "Quantity to write", "type": "uint16", "default": 1, "min": 1, "max": 121},
        {"name": "bytes", "label": "Nombre d'octets", "label_en": "Write byte count", "type": "uint8", "default": 2},
        {"name": "values", "label": "Valeurs à écrire", "label_en": "Values to write", "type": "raw", "default": "00 00"}
      ],
      "rx": [
