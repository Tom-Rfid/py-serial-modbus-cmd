 "patterns": [
  {
   "fr": "^requête( #.+)$",
   "en": "request{1}"
  },
  {
   "fr": "^réponse( #.+)$",
   "en": "response{1}"
  },
  {
   "fr": "^erreur (\\d+) \\((.+)\\)$",
   "en": "error {1} ({2})"
  },
  {
   "fr": "^erreur (\\d+)$",
   "en": "error {1}"
  },
  {
   "fr": "^(\\d+) o$",
   "en": "{1} B"
  },
  {
   "fr": "^(.+) incorrect$",
   "en": "{1} wrong"
  },
  {
   "fr": "^(.+) différent de (.+)$",
   "en": "{1} differs from {2}"
  },
  {
   "fr": "^trame tronquée : (.+) incomplet$",
   "en": "truncated frame: {1} incomplete"
  },
  {
   "fr": "^données tronquées : (\\d+) octets sur (\\d+)$",
   "en": "truncated data: {1} bytes out of {2}"
  },
  {
   "fr": "^attendu (.+) \\(comme (.+)\\)$",
   "en": "expected {1} (same as {2})"
  },
  {
   "fr": "^attendu (.+)$",
   "en": "expected {1}"
  },
  {
   "fr": "^(\\d+) octet\\(s\\) en trop$",
   "en": "{1} extra byte(s)"
  },
  {
   "fr": "^début de trame (.+) absent$",
   "en": "frame start {1} missing"
  },
  {
   "fr": "^fin de trame (.+) absente$",
   "en": "frame end {1} missing"
  },
  {
   "fr": "^(.+) : (\\d+) octet\\(s\\) attendus, (\\d+) fournis$",
   "en": "{1}: {2} byte(s) expected, {3} given"
  },
  {
   "fr": "^(.+) : (.+) hors limites \\(0 à (.+)\\)$",
   "en": "{1}: {2} out of range (0 to {3})"
  },
  {
   "fr": "^données attendues \\((\\d+) champ\\(s\\)\\) mais pas de DATA$",
   "en": "data expected ({1} field(s)) but no DATA"
  },
  {
   "fr": "^(.+) \\(inconnu\\)$",
   "en": "{1} (unknown)"
  },
  {
   "fr": "^(0x[0-9A-F]+) : aucun$",
   "en": "{1} : none"
  },
  {
   "fr": "^(.+) \\(BCD invalide\\)$",
   "en": "{1} (invalid BCD)"
  },
  {
   "fr": "^DATA trop courte pour '(.+)'$",
   "en": "DATA too short for '{1}'"
  },
  {
   "fr": "^(\\d+) octet\\(s\\) de DATA non décrits$",
   "en": "{1} DATA byte(s) not described"
  },
  {
   "fr": "^'(.+)' n'est pas un nombre$",
   "en": "'{1}' is not a number"
  },
  {
   "fr": "^(.+) < min \\((.+)\\)$",
   "en": "{1} < min ({2})"
  },
  {
   "fr": "^(.+) > max \\((.+)\\)$",
   "en": "{1} > max ({2})"
  },
  {
   "fr": "^(.+) hors limites du type (.+?) \\((.+) à (.+)\\)$",
   "en": "{1} out of range for type {2} ({3} to {4})"
  },
